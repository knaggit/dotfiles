[user]
	name = Marjan
	email = hello@knaggit.de
	signingkey = 0x7426E2F78A84EB06
[alias]
	l = log --oneline -n 20
	st = status -s
	go = checkout
[commit]
	gpgsign = true
[core]
	excludesfile = ~/.gitignore
	editor = hx
	pager = delta
[init]
	defaultBranch = main
[pull]
	rebase = true
[merge]
	conflictStyle = zdiff3
	tool = vscode
[mergetool "vscode"]
	cmd = code --wait $MERGED
[rerere]
	enabled = true
[delta]
	side-by-side = true
	syntax-theme = Coldark-Dark
[interactive]
	diffFilter = delta --color-only
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
